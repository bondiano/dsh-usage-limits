{
  "name": "@local/dsh-usage-limits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Left-sidebar limits panel: per-card subscription quotas (ChatGPT Codex, Claude, Grok, GitHub Copilot, Google Antigravity), provider windows, balances, model and platform limits.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
